# AI Agent Platform 环境变量示例（复制为 .env 后填写真实值）
# 严禁把真实密钥提交进代码/文档/日志（BRIEF 第八节 / DECISION-004）

# ---- LLM 底座（OpenAI 兼容，vLLM）----
LLM_BASE_URL=http://34.121.9.233:4000/v1
LLM_MODEL=vllm-qwen3.8-27b
# 从 ~/.hermes/profiles/zhangbeihai/.env 的 AI_MODEL_API_KEY 复制（勿写进代码/日志）
AI_MODEL_API_KEY=
LLM_TIMEOUT=90
# LLM_RETRIES=3

# ---- Embedding（OpenAI 兼容接口位；留空则用本地确定性哈希向量，DECISION-003）----
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# ---- 缓存路由（模块 14）----
SEMANTIC_CACHE_THRESHOLD=0.95

# ---- 记忆插件（模块 12）：local | redis | milvus | neo4j | hermes
MEMORY_BACKEND=local
# hermes 适配器的 JSONL 事实流输出路径
# HERMES_MEMORY_DIR=

# ---- RBAC ----
# JWT HS256 密钥：生产环境务必配置 >= 32 字节的随机长字符串（openssl rand -hex 32）。
# 留空/过短时后端运行时自动生成 64 hex 随机值（仅进程内有效，run.sh 会持久化到此 .env）。
# 生产必须显式配置，禁止使用默认短密钥（会触发 InsecureKeyLengthWarning，BUG-002）。
JWT_SECRET=
JWT_TTL_HOURS=24
# 4 个 seed 用户（admin/developer/user/viewer）的默认密码
SEED_PASSWORD=admin123

# ---- 服务 ----
HOST=0.0.0.0
PORT=8099
MAX_TOOL_ROUNDS=5

# ---- 链路追踪（TASK-057 / 迭代5）----
# trace 数据保留天数（默认 30）。启动时清理过期行（幂等，非阻塞）。
# 注意：此值也支持通过 /api/system/config 之外的 settings 表 trace_retention_days
# 动态配置（DB > env 优先级，DECISION-007 模式）；此处仅作 .env 默认位。
# 查询端点 /api/trace/* 要求 system:admin（安全优先，不跨 agent 泄露，见 README 链路追踪节）。
#TRACE_RETENTION_DAYS=30

# ---- 数据库（TASK-015 双后端：默认 SQLite 零依赖，PostgreSQL 可选）----
# 切换方式：只改 DB_BACKEND（sqlite | postgres），业务代码零感知。
#
# == 默认：SQLite（零外部依赖，clone 即跑）==
DB_BACKEND=sqlite
# 数据文件路径（相对按进程 cwd 解析）。
#   本地 run.sh: 默认 src/data/agp.db（可不配）
#   Docker compose: 必须设为 /app/data/agp.db（卷 ./src/data:/app/data 持久化）
#SQLITE_PATH=
#
# == 可选：PostgreSQL（连 pg-unified，agp schema；需外部网络 agp_default）==
# 密码来源：postgres-unified 项目 .env 的 AGP_USER_PASSWORD（勿外泄/勿进日志）
#DB_BACKEND=postgres
AGP_DB_PASSWORD=
DB_HOST=pg-unified
DB_PORT=5432
DB_NAME=postgres
DB_USER=agp_user
DB_SCHEMA=agp
